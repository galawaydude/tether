{
  "name": "remote-control-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Remote control for persistent coding agents",
  "license": "MIT",
  "author": "galawaydude",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galawaydude/remote-control-agent.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "postinstall": "find node_modules/node-pty -type f -name spawn-helper -exec chmod +x {} + 2>/dev/null || true",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p server && tsc --noEmit -p web && tsc --noEmit -p web/tsconfig.node.json && tsc --noEmit -p e2e",
    "check:pty": "node --disable-warning=ExperimentalWarning server/src/machine/pty-smoke.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "rcagent": "node --disable-warning=ExperimentalWarning server/src/cli.ts",
    "tether": "npm run rcagent --",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
